<!DOCTYPE html>
<html lang="cs-CZ">
  <head>
    <meta charset="utf-8" />
    <title>{{ title }} - {{ project }}</title>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, shrink-to-fit=no"
    />
    <meta name="format-detection" content="telephone=no" />

    <!--****** Favicon ******-->
    <!--****** Fonts ******-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" />

    <!--****** Styles  ******-->
    <link rel="preload" href="css/styles.css" as="style" />
    <link rel="stylesheet" media="screen, handheld" href="css/styles.css" />
    {% if title == "Tabulka A-týmu" %}<link rel="stylesheet" href="css/hc-roster.css" /><link rel="stylesheet" href="css/hc-standings.css" />{% endif %}
    {% if title == "Soupiska A-týmu" or title == "Tabulka A-týmu" %}<link rel="stylesheet" href="css/hc-roster.css" />{% endif %}
    <link rel="stylesheet" href="css/hc-select.css" />
    {% if title == "Mládež" or title == "Profil hráče" or title == "Realizační tým" %}<link rel="stylesheet" href="css/hc-subpages.css" />{% endif %}
    {% if title == "Archiv článků" or title == "Informace o klubu" %}<link rel="stylesheet" href="css/hc-editorial.css" />{% endif %}
    {% if title == "Zápasy A-týmu" or title == "Detail zápasu" %}<link rel="stylesheet" href="css/hc-matches.css" />{% endif %}
    <link rel="stylesheet" media="print" href="css/prints.css" />
    <!--****** Styles  ******-->

    <!--****** Scripts  ******-->
    <link
      rel="preload"
      href="https://code.jquery.com/jquery-3.6.0.min.js"
      as="script"
      crossorigin
    />
    <link
      rel="preload"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
      as="script"
      crossorigin
    />
    <link rel="preload" href="js/scripts.js" as="script" />
    <!-- ****** scripts ****** -->
    
  </head>
  <body>
    <div class="base">
      {% include "@components/header/header.twig" %}
      <main class="main" aria-label="Hlavní obsah">
        {% block main %}{% endblock %}
      </main>
      {% include "@components/footer/footer.twig" %}
    </div>
    <script
      defer
      src="https://code.jquery.com/jquery-3.6.0.min.js"
      integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4="
      crossorigin="anonymous"
    ></script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p"
      crossorigin="anonymous"
    ></script>
    <script defer src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
    <script defer src="js/scripts.js"></script>
    <script defer src="js/hc-select.js"></script>
  </body>
</html>
