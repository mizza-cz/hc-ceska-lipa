<section class="fan-page" data-fanshop data-order-url="{{ fanshop.orderAction|default('')|escape('html_attr') }}" data-csrf="{{ fanshop.csrfToken|default('')|escape('html_attr') }}">
  <div class="fan-banner">
    <div class="site-container">
      <nav class="fan-breadcrumbs" aria-label="Drobečková navigace"><a href="01.0_homepage.html">Úvod</a><span>/</span><strong>Fanshop</strong></nav>
      <span class="eyebrow">HC ČESKÁ LÍPA · KLUBOVÉ PRODUKTY</span>
      <h1>KLUBOVÝ <span>FANSHOP</span></h1>
      <p>#jedentym#jednomesto#spolecnesrdce</p>
    </div>
  </div>

  <div class="site-container fan-content">
    <div class="fan-head">
      <div><span class="eyebrow">V BARVÁCH NAŠEHO KLUBU</span><h2>VYBER SI <span>SVŮJ STYL</span></h2></div>
      <button type="button" class="fan-cart-button" data-fan-open="cart">Košík <span data-fan-count>0</span><span aria-hidden="true">→</span></button>
    </div>
    <div class="fan-tools">
      <div class="fan-filters" role="group" aria-label="Kategorie produktů">
        <button type="button" class="is-active" data-fan-filter="">Všechny produkty</button>
        {% for category in fanshop.categories %}
          <button type="button" data-fan-filter="{{ category.id|escape('html_attr') }}">{{ category.name|escape }}</button>
        {% endfor %}
      </div>
      <label class="fan-search"><span class="visually-hidden">Hledat produkt</span><input type="search" placeholder="Hledat produkt…" data-fan-search></label>
    </div>
    <div class="fan-products">
      {% for product in fanshop.products %}
        <article class="fan-product" data-fan-item data-product-id="{{ product.id|escape('html_attr') }}" data-category="{{ product.categoryId|escape('html_attr') }}" data-price="{{ product.price }}" data-currency="CZK">
          <button class="fan-product__image" type="button" data-fan-product="{{ product.id|escape('html_attr') }}" aria-label="Detail produktu {{ product.name|escape('html_attr') }}">
            {% if product.image %}
              <img class="fan-product__photo" src="{{ product.image|escape('html_attr') }}" alt="{{ product.name|escape('html_attr') }}" loading="lazy">
            {% else %}
              <span class="fan-art fan-art--{{ product.type|escape('html_attr') }}" aria-hidden="true"><span class="fan-art__item"><img src="/assets/images/content/logo.png" alt=""></span></span>
            {% endif %}
          </button>
          <div class="fan-product__content">
            <span class="fan-product__category">{{ product.category|escape }}</span>
            <h2>{{ product.name|escape }}</h2>
            <div class="fan-product__foot">
              <strong>{{ product.price|number_format(0, ',', ' ') }} Kč</strong>
              <button class="fan-product__detail" type="button" data-fan-product="{{ product.id|escape('html_attr') }}">Detail produktu <span aria-hidden="true">↗</span></button>
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
    <p class="fan-noresults" data-fan-noresults hidden>Žádné produkty neodpovídají hledání.</p>
    {% if fanshop.isDemo %}
      <p class="fan-demo">Ukázkové produkty a ceny. Objednávky se bez připojeného backendu neodesílají.</p>
    {% endif %}
  </div>

  {# All product content comes from Twig/server data, never from JS product arrays. #}
  {% for product in fanshop.products %}
    <template data-fan-detail-template="{{ product.id|escape('html_attr') }}">
      <div class="fan-detail">
        {% if product.image %}
          <img class="fan-detail__photo" src="{{ product.image|escape('html_attr') }}" alt="{{ product.name|escape('html_attr') }}">
        {% else %}
          <span class="fan-art fan-art--{{ product.type|escape('html_attr') }}" aria-hidden="true"><span class="fan-art__item"><img src="/assets/images/content/logo.png" alt=""></span></span>
        {% endif %}
        <div class="fan-detail__content">
          <span class="eyebrow">{{ product.category|escape }}</span>
          <h3>{{ product.name|escape }}</h3>
          <strong class="fan-price">{{ product.price|number_format(0, ',', ' ') }} Kč</strong>
          <p>{{ product.description|escape }}</p>
          <form data-fan-add data-product-id="{{ product.id|escape('html_attr') }}">
            {% if product.variants|length > 1 %}
              <fieldset class="fan-size">
                <legend>Velikost / varianta</legend>
                {% for variant in product.variants %}
                  <label><input type="radio" name="variantId" value="{{ variant.id|escape('html_attr') }}" {% if loop.first %}checked{% endif %}><span>{{ variant.name|escape }}</span></label>
                {% endfor %}
              </fieldset>
            {% elseif product.variants|length == 1 %}
              <input type="hidden" name="variantId" value="{{ product.variants[0].id|escape('html_attr') }}">
            {% endif %}
            <label class="fan-quantity">Množství <input name="qty" type="number" min="1" max="99" value="1" required></label>
            <button class="fan-primary" type="submit">Přidat do košíku →</button>
          </form>
        </div>
      </div>
    </template>
  {% endfor %}

  <template data-fan-template="cart">
    <div class="fan-cart-layout">
      <div><div class="fan-lines" data-fan-lines></div><button type="button" class="fan-link" data-fan-close>← Pokračovat v nákupu</button></div>
      <aside class="fan-summary-card">
        <h3>Shrnutí nákupu</h3>
        <div><span>Produkty</span><strong data-fan-subtotal></strong></div>
        <div><span>Doprava</span><span>V dalším kroku</span></div>
        <div class="fan-summary-card__total"><span>Mezisoučet</span><strong data-fan-subtotal></strong></div>
        <button class="fan-primary" type="button" data-fan-open="checkout">Pokračovat k objednávce →</button>
      </aside>
    </div>
  </template>
  <template data-fan-template="cart-empty">
    <div class="fan-empty"><h3>Váš košík je prázdný</h3><p>Vyberte si produkty z klubové nabídky.</p><button type="button" class="fan-primary" data-fan-close>Prohlédnout produkty</button></div>
  </template>
  <template data-fan-template="cart-line">
    <div class="fan-line">
      <div data-fan-line-image></div>
      <div class="fan-line__main"><strong data-fan-line-name></strong><small data-fan-line-variant></small><span data-fan-line-price></span></div>
      <div class="fan-line__controls"><label>Ks <input type="number" min="1" max="99" data-fan-qty></label><button type="button" data-fan-remove>Odebrat</button></div>
      <strong class="fan-line__total" data-fan-line-total></strong>
    </div>
  </template>
  <template data-fan-template="summary-line">
    <div class="fan-summary-line"><span data-fan-summary-name></span><strong data-fan-summary-price></strong></div>
  </template>
  <template data-fan-template="checkout">
    <div class="fan-steps"><b>01 Košík</b><b class="is-active">02 Objednávka</b><b>03 Shrnutí</b></div>
    <form data-fan-checkout class="fan-checkout" method="post">
      <div class="fan-checkout__fields">
        <h3>Kontaktní údaje</h3>
        <div class="fan-form-grid">
          <label>Jméno *<input name="firstName" autocomplete="given-name" required></label>
          <label>Příjmení *<input name="lastName" autocomplete="family-name" required></label>
          <label>E-mail *<input name="email" type="email" autocomplete="email" required></label>
          <label>Telefon *<input name="phone" type="tel" autocomplete="tel" required></label>
        </div>
        <h3>Doručovací adresa</h3>
        <div class="fan-form-grid">
          <label class="fan-wide">Ulice a číslo popisné *<input name="street" autocomplete="street-address" required></label>
          <label>Město *<input name="city" autocomplete="address-level2" required></label>
          <label>PSČ *<input name="zip" autocomplete="postal-code" pattern="[0-9 ]{5,6}" placeholder="470 01" required></label>
        </div>
        <h3>Doprava</h3>
        <div class="fan-radio">
          {% for option in fanshop.shippingOptions %}
            <label><input type="radio" name="shipping" value="{{ option.id|escape('html_attr') }}" data-price="{{ option.price }}" data-is-pickup="{% if option.isPickup %}true{% else %}false{% endif %}" {% if loop.first %}checked{% endif %}><span><strong>{{ option.name|escape }}</strong><small>{{ option.price|number_format(0, ',', ' ') }} Kč</small></span></label>
          {% endfor %}
        </div>
        <h3>Platba</h3>
        <div class="fan-radio">
          {% for option in fanshop.paymentOptions %}
            <label><input type="radio" name="payment" value="{{ option.id|escape('html_attr') }}" data-pickup-only="{% if option.pickupOnly %}true{% else %}false{% endif %}" {% if loop.first %}checked{% endif %}><span><strong>{{ option.name|escape }}</strong>{% if option.description %}<small>{{ option.description|escape }}</small>{% endif %}</span></label>
          {% endfor %}
        </div>
        <label>Poznámka<textarea name="note" rows="3" placeholder="Nepovinné"></textarea></label>
        <p class="fan-demo" data-fan-form-error hidden></p><div class="fan-checkout__actions">
          <button type="button" class="fan-secondary" data-fan-open="cart">← Zpět do košíku</button>
          <button type="submit" class="fan-primary">Zobrazit shrnutí →</button>
        </div>
      </div>
      <aside class="fan-summary-card"><h3>Souhrn objednávky</h3><div data-fan-summary-lines></div><div><span>Doprava</span><strong data-fan-shipping></strong></div><div class="fan-summary-card__total"><span>Celkem</span><strong data-fan-total></strong></div></aside>
    </form>
  </template>
  <template data-fan-template="summary">
    <div class="fan-steps"><b>01 Košík</b><b>02 Objednávka</b><b class="is-active">03 Shrnutí</b></div>
    <div class="fan-finished">
      <h3>Kontrola objednávky</h3>
      <p data-fan-summary-message></p>
      <div class="fan-finished__details">
        <div><strong>Zákazník</strong><span data-fan-customer></span><span data-fan-email></span><span data-fan-phone></span></div>
        <div><strong>Doručení</strong><span data-fan-shipping-name></span><span data-fan-address></span><span data-fan-payment-name></span></div>
      </div>
      <div class="fan-summary-card"><h3>Objednané produkty</h3><div data-fan-summary-lines></div><div><span>Doprava</span><strong data-fan-shipping></strong></div><div class="fan-summary-card__total"><span>Celkem</span><strong data-fan-total></strong></div></div>
      {% if fanshop.orderAction %}
        <button class="fan-primary" type="button" data-fan-submit-order>Odeslat objednávku</button>
      {% else %}
        <button class="fan-secondary" type="button" data-fan-close>Zavřít ukázku</button>
      {% endif %}
    </div>
  </template>

  <div class="fan-overlay" data-fan-overlay hidden>
    <div class="fan-overlay__backdrop" data-fan-close></div>
    <section class="fan-dialog" role="dialog" aria-modal="true" aria-labelledby="fan-dialog-title" tabindex="-1">
      <header class="fan-dialog__header"><div><span class="fan-dialog__overline">HC ČESKÁ LÍPA · FANSHOP</span><h2 id="fan-dialog-title" data-fan-title>Detail produktu</h2></div><button type="button" class="fan-dialog__close" data-fan-close aria-label="Zavřít okno">×</button></header>
      <div class="fan-dialog__body" data-fan-body></div>
    </section>
  </div>
</section>